# =============================================================================
# Ahar — environment variables
# =============================================================================
# Copy to `.env.local` (git-ignored) and fill in. NEVER commit real secrets.
#
# Rule of thumb:
#   * NEXT_PUBLIC_*  -> shipped to the browser. ONLY non-secret, publishable
#                       identifiers belong here (Supabase URL, anon key, Stripe
#                       publishable key). These are safe to expose by design.
#   * everything else -> server-only. Read exclusively in route handlers /
#                        server code and never sent to the client bundle.
# -----------------------------------------------------------------------------

# --- Public (safe for the browser) -------------------------------------------
# The anon key is the intended "public DB key": it is meaningless without the
# Row-Level Security policies that gate every table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secret (server only — NEVER prefix with NEXT_PUBLIC) ---------------------
# The service role key bypasses RLS. Guard it like a password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
